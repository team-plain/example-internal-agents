# Plain API key for the machine user this agent runs as. Set it up as in
# https://www.plain.com/docs/agents, with threadDiscussion:read, threadDiscussion:edit,
# threadDiscussionMessage:create, threadDiscussionMessage:edit, thread:read and thread:reply.
PLAIN_API_KEY=

# Workspace webhook signing secret: Plain → Settings → Request Signing.
PLAIN_WEBHOOK_SECRET=

# Required. The model credential. This package passes a bare model id to the AI SDK, which routes
# it through the Vercel AI Gateway. `eve link` can supply a VERCEL_OIDC_TOKEN instead.
AI_GATEWAY_API_KEY=

# Optional. Overrides the Plain API endpoint, which defaults to production.
PLAIN_API_URL=

# Optional. Defaults to anthropic/claude-sonnet-5. Any model id the gateway serves works.
AGENT_MODEL=

# Optional. Skips the workspace lookup used to build clickable thread links. Set it when your
# machine user lacks the scope to read the workspace, otherwise links come back null.
PLAIN_WORKSPACE_ID=
