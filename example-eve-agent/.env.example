# Plain API key for the machine user this agent runs as. Needs the Connected agent type, plus
# threadDiscussion:read, threadDiscussion:edit, threadDiscussionMessage:create,
# threadDiscussionMessage:edit, thread:read and thread:reply.
#
# This file wins over an exported PLAIN_API_KEY in your shell. A stale one otherwise runs the agent
# against a different workspace, which looks like an empty knowledge base.
PLAIN_API_KEY=

# Workspace webhook signing secret: Plain → Settings → Request Signing.
PLAIN_WEBHOOK_SECRET=

# Optional. Overrides the Plain API endpoint, which defaults to production.
PLAIN_API_URL=

# The model credential. eve's default model is a string id routed through the Vercel AI Gateway,
# which needs this. `eve link` pulls a VERCEL_OIDC_TOKEN instead, and a direct provider model needs
# that provider's own key. See the README.
AI_GATEWAY_API_KEY=

# Optional. Skips the workspace lookup used to build clickable thread links. Set it when your
# machine user lacks the scope to read the workspace, otherwise links come back null.
PLAIN_WORKSPACE_ID=
